<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <com.android.car.ui.FocusParkingView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This Activity is supported by rotary on Android S+">
    </TextView>

    <com.android.car.ui.FocusArea
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="200dp">

        <!-- button1 and button2 are optional. They're used to demo what to do when there are
             focusable views surrounding the ComposeView. -->
        <Button
                android:id="@+id/button1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="button1" />

        <!-- The ComposeView cna be focused transiently when rotating controller between Composables
             and surrounding focusable Views, so disable its focus highlight. -->
        <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_view"
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:layout_marginHorizontal="24dp"
                android:focusable="true"
                android:defaultFocusHighlightEnabled="false"/>

        <Button
                android:id="@+id/button2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="button2" />
    </com.android.car.ui.FocusArea>

</LinearLayout>
